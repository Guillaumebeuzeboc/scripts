#!/bin/sh
set -eu

# Fix LXD/Docker connectivity issues caused by Docker setting FORWARD policy to DROP.
# Reference:
# https://documentation.ubuntu.com/lxd/default/howto/network_bridge_firewalld/#prevent-connectivity-issues-with-lxd-and-docker

usage() {
  cat <<'EOF'
Usage: lxd-docker-network-fix [--bridge BRIDGE] [--mode MODE]

Modes:
  docker-user-rules  Add DOCKER-USER allow rules for the LXD bridge (default)
  ipv4-forwarding    Persist net.ipv4.conf.all.forwarding=1 via /etc/sysctl.d/99-forwarding.conf
  both               Apply both modes

Options:
  --bridge BRIDGE    LXD bridge name (default: lxdbr0)
  --mode MODE        One of docker-user-rules|ipv4-forwarding|both
  -h, --help         Show this help

Examples:
  sudo sh lxd-docker-network-fix
  sudo sh lxd-docker-network-fix --bridge lxdbr0 --mode both
EOF
}

require_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "Error: run as root (use sudo)." >&2
    exit 1
  fi
}

ensure_bridge_exists() {
  bridge="$1"
  if command -v ip >/dev/null 2>&1 && ip link show "$bridge" >/dev/null 2>&1; then
    return 0
  fi

  if command -v lxc >/dev/null 2>&1 && lxc network show "$bridge" >/dev/null 2>&1; then
    return 0
  fi

  echo "Error: bridge '$bridge' not found. Provide a valid bridge with --bridge." >&2
  exit 1
}

ensure_iptables_tools() {
  if ! command -v iptables >/dev/null 2>&1 || ! command -v ip6tables >/dev/null 2>&1; then
    echo "Error: iptables/ip6tables not found. Install iptables and retry." >&2
    exit 1
  fi
}

ensure_chain() {
  table_bin="$1"
  if ! "$table_bin" -nL DOCKER-USER >/dev/null 2>&1; then
    echo "Error: ${table_bin} chain DOCKER-USER not found." >&2
    echo "Start Docker first so the DOCKER-USER chain exists, then re-run this script." >&2
    exit 1
  fi
}

ensure_rule() {
  table_bin="$1"
  shift
  if "$table_bin" -C DOCKER-USER "$@" >/dev/null 2>&1; then
    echo "${table_bin}: rule already present: $*"
  else
    "$table_bin" -I DOCKER-USER "$@"
    echo "${table_bin}: added rule: $*"
  fi
}

apply_docker_user_rules() {
  bridge="$1"

  ensure_iptables_tools
  ensure_chain iptables
  ensure_chain ip6tables

  ensure_rule iptables  -i "$bridge" -j ACCEPT
  ensure_rule ip6tables -i "$bridge" -j ACCEPT
  ensure_rule iptables  -o "$bridge" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
  ensure_rule ip6tables -o "$bridge" -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT

  if command -v netfilter-persistent >/dev/null 2>&1; then
    netfilter-persistent save
    echo "Saved firewall rules with netfilter-persistent."
  elif command -v iptables-save >/dev/null 2>&1; then
    echo "Important: make firewall rules persistent across reboots for your distro."
    echo "Suggestion (Debian/Ubuntu): install iptables-persistent (netfilter-persistent)."
  fi
}

apply_ipv4_forwarding() {
  sysctl_file="/etc/sysctl.d/99-forwarding.conf"
  key="net.ipv4.conf.all.forwarding"
  value="1"

  if [ -f "$sysctl_file" ] && grep -Eq "^${key}=${value}$" "$sysctl_file"; then
    echo "${sysctl_file} already contains ${key}=${value}."
  else
    printf '%s\n' "${key}=${value}" > "$sysctl_file"
    echo "Wrote ${sysctl_file}."
  fi

  if command -v systemctl >/dev/null 2>&1; then
    systemctl restart systemd-sysctl
  else
    sysctl -p "$sysctl_file"
  fi

  echo "Applied persistent IPv4 forwarding (${key}=${value})."
}

BRIDGE="lxdbr0"
MODE="docker-user-rules"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --bridge)
      [ "$#" -ge 2 ] || { echo "Error: --bridge requires a value." >&2; exit 1; }
      BRIDGE="$2"
      shift 2
      ;;
    --mode)
      [ "$#" -ge 2 ] || { echo "Error: --mode requires a value." >&2; exit 1; }
      MODE="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "Error: unknown argument: $1" >&2
      usage
      exit 1
      ;;
  esac
done

case "$MODE" in
  docker-user-rules|ipv4-forwarding|both)
    ;;
  *)
    echo "Error: invalid --mode '$MODE'." >&2
    usage
    exit 1
    ;;
esac

require_root
ensure_bridge_exists "$BRIDGE"

case "$MODE" in
  docker-user-rules)
    apply_docker_user_rules "$BRIDGE"
    ;;
  ipv4-forwarding)
    apply_ipv4_forwarding
    ;;
  both)
    apply_ipv4_forwarding
    apply_docker_user_rules "$BRIDGE"
    ;;
esac

echo "Done."